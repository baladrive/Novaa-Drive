VITE_ADMIN_EMAIL=admin@example.com
VITE_ADMIN_USERNAME=admin
VITE_ADMIN_PASSWORD_HASH=
VITE_ADMIN_AUTO_LOGIN=false
# Novaa Drive - Environment Variables Reference
# Copy this file to .env and fill in values
# Never commit .env.local or .env.production to git

VITE_APP_NAME=Novaa Drive
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=development

# Session security (minutes)
VITE_SESSION_TIMEOUT_MINUTES=60

# Rate limiting
VITE_MAX_LOGIN_ATTEMPTS=5
VITE_LOCKOUT_DURATION_MINUTES=15

# Demo user credentials (required — app will crash without these)
VITE_DEMO_USER_ID=usr_demo_novaa
VITE_DEMO_USER_EMAIL=admin@novaadrive.com
VITE_DEMO_USER_USERNAME=admin
VITE_DEMO_USER_FULLNAME=Novaa Admin
# SHA-256 of "Admin@1234"
VITE_DEMO_PASSWORD_HASH=bc78e58d55cde1346e68f8e5fe588dedf62fa457aa646a500a53347faff6ee24
VITE_SESSION_KEY=novaa_drive_session_key_2024
