# Copy this file to .env.local and fill in real values. Never commit .env.local.
# VITE_DEMO_PASSWORD_HASH = SHA-256 hex of your chosen password.
# Generate with: node -e "const c=require('crypto');console.log(c.createHash('sha256').update('yourpassword').digest('hex'))"

VITE_DEMO_USER_ID=usr_demo_novaa
VITE_DEMO_USER_EMAIL=admin@novaadrive.com
VITE_DEMO_USER_USERNAME=admin
VITE_DEMO_USER_FULLNAME=<full name of the demo user>
VITE_DEMO_PASSWORD_HASH=<sha256-hex-of-your-password>
VITE_SESSION_KEY=<random-unpredictable-string>
